// Firestore Security Rules for Money Control V3 (Multi-Account & Secure Delete)
// Deploy via Firebase Console > Firestore > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify that an OTP deletion session exists and is verified
    function isDeleteVerified(userId, targetId) {
      return (
        (exists(/databases/$(database)/documents/users/$(userId)/deleteSessions/$(targetId))
          && get(/databases/$(database)/documents/users/$(userId)/deleteSessions/$(targetId)).data.verified == true
          && get(/databases/$(database)/documents/users/$(userId)/deleteSessions/$(targetId)).data.expiresAt > request.time.toMillis())
        ||
        (exists(/databases/$(database)/documents/users/$(userId)/deleteSessions/global)
          && get(/databases/$(database)/documents/users/$(userId)/deleteSessions/global).data.verified == true
          && get(/databases/$(database)/documents/users/$(userId)/deleteSessions/global).data.expiresAt > request.time.toMillis())
      );
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Delete verification sessions subcollection
      match /deleteSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Accounts subcollection
      match /accounts/{accountId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.type in ['Cash', 'Bank', 'UPI', 'Other']
          && request.resource.data.initialBalance is number;

        // Secure deletion: requires verified OTP session
        allow delete: if request.auth != null && request.auth.uid == userId
          && isDeleteVerified(userId, accountId);
      }

      // Transactions subcollection (INCOME, EXPENSE, TRANSFER)
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.type in ['INCOME', 'EXPENSE', 'TRANSFER']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;

        allow delete: if request.auth != null && request.auth.uid == userId
          && isDeleteVerified(userId, transactionId);
      }
      
      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId
          && isDeleteVerified(userId, budgetId);
      }

      // Friend Money subcollection (keeps existing "no delete" or restricted behavior)
      match /friendMoney/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
